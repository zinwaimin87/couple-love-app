rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /coupleMembers/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;

      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.ownerUid == request.auth.uid;

      allow list: if false;
      allow delete: if false;
    }


    match /couplePresence/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == email
          || (
            exists(/databases/$(database)/documents/coupleMembers/$(request.auth.token.email))
            && get(/databases/$(database)/documents/couples/$(get(/databases/$(database)/documents/coupleMembers/$(request.auth.token.email)).data.ownerUid)).data.get('ownerGmail','') == request.auth.token.email
            && (
              email == get(/databases/$(database)/documents/couples/$(get(/databases/$(database)/documents/coupleMembers/$(request.auth.token.email)).data.ownerUid)).data.get('ownerGmail','')
              || email == get(/databases/$(database)/documents/couples/$(get(/databases/$(database)/documents/coupleMembers/$(request.auth.token.email)).data.ownerUid)).data.get('partnerGmail','')
            )
          )
        );

      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;

      allow list: if false;
      allow delete: if request.auth != null && request.auth.token.email == email;
    }

    match /couples/{uid} {
      function signedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }

      function isPartner() {
        return signedIn()
          && resource.data.get('partnerGmail', '') != ''
          && request.auth.token.email_verified == true
          && request.auth.token.email == resource.data.get('partnerGmail', '');
      }

      allow get: if isOwner() || isPartner();
      allow list: if false;

      allow create: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isOwner()
        || (
          isPartner()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.partnerGmail == resource.data.partnerGmail
        );


      match /messages/{messageId} {
        function messageOwner() {
          return request.auth != null && request.auth.uid == uid;
        }

        function messagePartner() {
          return request.auth != null
            && request.auth.token.email_verified == true
            && get(/databases/$(database)/documents/couples/$(uid)).data.get('partnerGmail','') == request.auth.token.email;
        }

        allow get, list: if messageOwner() || messagePartner();

        allow create: if (messageOwner() || messagePartner())
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderEmail == request.auth.token.email;

        allow update: if (messageOwner() || messagePartner())
          && resource.data.senderUid == request.auth.uid
          || (
            (messageOwner() || messagePartner())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt','readAt'])
          );

        allow delete: if messageOwner() || messagePartner();
      }

      allow delete: if isOwner();
    }
  }
}
