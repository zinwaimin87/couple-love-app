rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /coupleMembers/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;

      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.ownerUid == request.auth.uid;

      allow list: if false;
      allow delete: if false;
    }

    match /couples/{uid} {
      function signedIn() {
        return request.auth != null;
      }

      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }

      function isPartner() {
        return signedIn()
          && resource.data.get('partnerGmail', '') != ''
          && request.auth.token.email_verified == true
          && request.auth.token.email == resource.data.get('partnerGmail', '');
      }

      allow get: if isOwner() || isPartner();
      allow list: if false;

      allow create: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isOwner()
        || (
          isPartner()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.partnerGmail == resource.data.partnerGmail
        );

      allow delete: if isOwner();
    }
  }
}
